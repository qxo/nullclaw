          "runtime_name": "wechat_ilink",
          "transport": {
            "command": "node",
            "args": ["nullclaw-plugin-wechat-ilink.js"],
            "timeout_ms": 300000
          },
          "config": {
            "allow_from": ["*"],
            "group_policy": "allowlist"
          }
